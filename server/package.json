{
  "name": "mahdi-barbershop-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx scripts/migrate.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx test/domain.test.ts test/cors.test.ts test/postgres.integration.test.ts",
    "test:unit": "node --test --import tsx test/domain.test.ts test/cors.test.ts",
    "test:integration": "node --test --import tsx test/postgres.integration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
